# Example ~/.codex/config.toml — copy and edit it for your environment
#
#   cp codex/config.toml.example ~/.codex/config.toml
#
# This example provides safe defaults for read-only work such as /persona-review.
# Raise sandbox_mode and approval_policy explicitly for tasks that need to write code.
# (The codex/ tree is independent of plugins/ and Claude-side .claude/settings.)

# Default model. Adjust it for your organization policy and subscription.
model = "gpt-5-codex"

# Reasoning effort: minimal | low | medium | high
model_reasoning_effort = "high"

# Approval policy:
#   untrusted   = request approval for untrusted commands (safest)
#   on-failure  = request approval only after sandbox failure
#   on-request  = let the model request approval when needed
#   never       = never request approval (dangerous; automation only)
approval_policy = "untrusted"

# Sandbox:
#   read-only            = read files only; default for review work such as /persona-review
#   workspace-write      = allow writes inside the working directory
#   danger-full-access   = unrestricted access (not recommended)
sandbox_mode = "read-only"

# AGENTS.md loading limit in bytes. 0 disables the limit.
project_doc_max_bytes = 32768

# Settings that apply only with workspace-write (reference only; keep commented)
# [sandbox_workspace_write]
# network_access = false      # deny network access by default, matching supply-chain policy
# writable_roots = []

# Optional MCP servers. Add only when needed.
# [mcp_servers.example]
# command = "npx"
# args = ["-y", "@example/mcp-server"]
