{
  "type": "object",
  "required": ["issue", "branch", "date", "title", "subtitle", "priority_groups"],
  "properties": {
    "issue": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "priority_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["priority", "label", "cards"],
        "properties": {
          "priority": { "type": "string", "enum": ["p0", "p1", "p2"] },
          "label": { "type": "string", "minLength": 3 },
          "cards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["card_id", "num", "title", "background", "judgment_question", "options"],
              "properties": {
                "card_id": { "type": "string", "pattern": "^c[0-9]+$" },
                "num": { "type": "number" },
                "open_class": { "type": "string", "enum": ["", " open"] },
                "title": {
                  "type": "string",
                  "minLength": 5,
                  "forbid": [
                    "#[0-9]+",
                    "[A-Z][a-zA-Z]*Entity",
                    "[A-Z][a-zA-Z]*\\.class",
                    "\\b[a-z]+_[a-z]+(?:_[a-z]+)+\\b"
                  ]
                },
                "background": {
                  "type": "object",
                  "required": ["situation", "pain", "divergence"],
                  "properties": {
                    "situation": {
                      "type": "string",
                      "minLength": 20,
                      "forbid": [
                        "#[0-9]+",
                        "[A-Z][a-zA-Z]*Entity",
                        "[A-Z][a-zA-Z]*\\.class",
                        "\\b[a-z]+_[a-z]+(?:_[a-z]+)+\\b",
                        "\\bR[0-9]{1,2}\\b"
                      ]
                    },
                    "pain": {
                      "type": "string",
                      "minLength": 15,
                      "mustMatch": ["(?i)([0-9]|miss|fail|delay|blocked|lost|late|cost|risk|refund|wait)"],
                      "forbid": [
                        "#[0-9]+",
                        "[A-Z][a-zA-Z]*Entity",
                        "[A-Z][a-zA-Z]*\\.class"
                      ]
                    },
                    "divergence": {
                      "type": "string",
                      "minLength": 15,
                      "forbid": [
                        "#[0-9]+",
                        "[A-Z][a-zA-Z]*Entity",
                        "[A-Z][a-zA-Z]*\\.class"
                      ]
                    }
                  }
                },
                "judgment_question": {
                  "type": "string",
                  "minLength": 10,
                  "endsWith": "?",
                  "forbid": [
                    "#[0-9]+",
                    "[A-Z][a-zA-Z]*Entity",
                    "[A-Z][a-zA-Z]*\\.class"
                  ]
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "required": ["key", "label"],
                    "properties": {
                      "key": { "type": "string", "enum": ["A", "B", "C"] },
                      "label": {
                        "type": "string",
                        "minLength": 5,
                        "forbid": [
                          "#[0-9]+",
                          "[A-Z][a-zA-Z]*Entity",
                          "[A-Z][a-zA-Z]*\\.class"
                        ]
                      },
                      "rec_badge": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
