{
  "type": "object",
  "required": ["label", "title", "phases"],
  "properties": {
    "label":     { "type": "string", "minLength": 1 },
    "title":     { "type": "string", "minLength": 1 },
    "lead":      { "type": "string" },
    "startDate": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "tasks"],
        "properties": {
          "name":  { "type": "string", "minLength": 1 },
          "color": { "type": "string" },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "status"],
              "properties": {
                "title":    { "type": "string", "minLength": 1 },
                "status":   { "type": "string", "enum": ["todo", "doing", "done", "dropped"] },
                "reason":   { "type": "string" },
                "hold":     { "type": "boolean" },
                "owner":    { "type": "string" },
                "period":   { "type": "string" },
                "estimate": { "type": "string" },
                "ticket":   { "type": "string" },
                "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "labels":   { "type": "array", "items": { "type": "string" } },
                "desc":     { "type": "array", "items": { "type": "string" } },
                "criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text", "done"],
                    "properties": {
                      "text": { "type": "string" },
                      "done": { "type": "boolean" }
                    }
                  }
                },
                "subs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text", "done"],
                    "properties": {
                      "text": { "type": "string" },
                      "done": { "type": "boolean" }
                    }
                  }
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "items"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["t", "done"],
                          "properties": {
                            "t":    { "type": "string", "minLength": 1 },
                            "done": { "type": "boolean" },
                            "sub":  { "type": "array", "items": { "type": "string", "minLength": 1 } }
                          }
                        }
                      }
                    }
                  }
                },
                "deps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tag", "text"],
                    "properties": {
                      "tag":  { "type": "string", "enum": ["blocker", "dep"] },
                      "text": { "type": "string" }
                    }
                  }
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "url"],
                    "properties": {
                      "label": { "type": "string" },
                      "url":   { "type": "string" }
                    }
                  }
                },
                "activity": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["who", "date", "text"],
                    "properties": {
                      "who":  { "type": "string" },
                      "date": { "type": "string" },
                      "text": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label":  { "type": "string" },
          "href":   { "type": "string" },
          "layer":  { "type": "string" },
          "reader": { "type": "string" }
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "docs"],
        "properties": {
          "role": { "type": "string" },
          "docs": { "type": "string" }
        }
      }
    }
  }
}
